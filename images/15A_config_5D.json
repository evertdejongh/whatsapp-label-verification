{
  "layout_agnostic": true,
  "extract_fields": {
    "CustomerCode": "the customer code printed in large bold font on the label (e.g. '5D')",
    "OrderNumber": "the value printed next to 'Номер партии:'",
    "BarcodeReadable": "the value printed next to 'Бар код:'",
    "PUC": "the value printed next to 'PUC/УКП:'",
    "GGN": "the 13-digit value printed next to 'GGN/ГГН:'",
    "PackDate": "the date printed next to 'дата упаковки:', in dd/mm/yyyy format"
  },
  "field_checks": [
    {
      "field": "CustomerCode",
      "name": "Customer code",
      "expected_pattern": "^5D$"
    },
    {
      "field": "OrderNumber",
      "name": "Order number format",
      "expected_pattern": "^.{4,}$"
    },
    {
      "field": "BarcodeReadable",
      "name": "Bar code printed"
    },
    {
      "field": "GGN",
      "name": "GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    },
    {
      "field": "PackDate",
      "name": "Pack date format",
      "expected_pattern": "^\\d{1,2}/\\d{1,2}/\\d{4}$"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GGN"
    }
  ],
  "date_freshness_checks": [
    {
      "name": "Pack date is recent",
      "field": "PackDate",
      "date_format": "%d/%m/%Y",
      "max_days_diff": 2
    }
  ]
}
