{
  "layout_agnostic": true,
  "extract_fields": {
    "Variety": null,
    "LotNumber": "the lot/batch code printed on the label"
  },
  "field_checks": [
    {
      "field": "LotNumber",
      "name": "Lot number"
    }
  ],
  "lookup_rules": [
    {
      "name": "Variety lookup",
      "table": "whatsapp-variety",
      "key": {
        "VarietyName": "field:Variety"
      },
      "query": true,
      "store_as": "variety"
    }
  ]
}