{
  "layout_agnostic": true,
  "extract_fields": {
    "PUC": null,
    "Variety": null,
    "Pack": null,
    "InventoryCode": null,
    "GrowerGGN": "the 13-digit GGN number printed directly next to the 'Grower:' heading -- there is a second, separate 13-digit GGN printed below the Packhouse address block; do not confuse the two",
    "Packhouse": null,
    "Key": null,
    "Brand": null,
    "BerrySize": "the value printed next to the 'Berry Size' heading (e.g. 'Regular', 'L')",
    "PackhouseGGN": "the 13-digit GGN number printed directly below/after the Packhouse address block -- there is a separate GGN printed next to the 'Grower:' heading; do not confuse the two",
    "IANNumber": "a standalone short numeric code (about 5 digits), usually printed near the top of the label close to a multi-language translation block -- NOT the long alphanumeric traceability code, and NOT the barcode number",
    "LidlProductNumber": "a long alphanumeric traceability/batch code (around 17 characters, mixing letters and digits, e.g. like 'GR007198BZA999808'), usually printed right after a shorter batch/lot code such as 'L36-04'",
    "BarcodeNumber": "the long numeric string printed directly with/under the barcode graphic itself"
  },
  "field_checks": [
    {
      "field": "IANNumber",
      "name": "IAN number",
      "expected_pattern": "\\b\\d{5}\\b"
    },
    {
      "field": "GrowerGGN",
      "name": "Grower GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    },
    {
      "field": "Packhouse",
      "name": "PHC address"
    },
    {
      "field": "LidlProductNumber",
      "name": "Lidl Product number"
    },
    {
      "field": "Key",
      "name": "Lidl key",
      "expected_pattern": "1\\s*1\\s*4"
    },
    {
      "field": "BarcodeNumber",
      "name": "Barcode and address"
    },
    {
      "field": "Pack",
      "name": "Allowed Pack code",
      "expected_pattern": "^A05D$"
    },
    {
      "field": "InventoryCode",
      "name": "Allowed Inventory code",
      "expected_pattern": "^P5$"
    },
    {
      "field": "BerrySize",
      "name": "Allowed Berry Size",
      "expected_pattern": "^L$"
    },
    {
      "field": "Brand",
      "name": "Allowed Brand",
      "expected_pattern": "^LIDGN$"
    }
  ],
  "text_blocks": {
    "Variety Group languages": "the block of text listing this product's name translated into approximately 23 different European languages",
    "Country languages": "the block of text listing 'South Africa' translated into approximately 23 different European languages"
  },
  "text_block_checks": [
    {
      "block": "Variety Group languages",
      "expected_token_count": 23
    },
    {
      "block": "Country languages",
      "expected_token_count": 23,
      "expected_content": "Südafrika / South Africa / Afrique du Sud / Sudáfrica / Sud Africa / África do Sul / Νότια Αφρική / Zuid-Afrika / Etelä-Afrikka / Sydafrika / Sydafrika / Dél-afrikai Köztársaság / Jihoafrická republika / RPA / Južnoafrička Republika / Juhoafrická republika / Južna Afrika / ЮАР / Africa de Sud / Pietu Afrika / Južna Afrika / Dienvidafrika / Lõuna-Aafrika",
      "fuzzy_threshold": 0.9
    }
  ],
  "full_label_checks": [
    {
      "name": "Supplier name",
      "pattern": "DOLE\\s+SOUTH\\s+AFRICA\\s*\\(PTY\\)\\s*LTD"
    },
    {
      "name": "Supplier registration number",
      "pattern": "6009644340002"
    },
    {
      "name": "Origin statement",
      "pattern": "(ORIGIN\\s+SOUTH\\s+AFRICA|COUNTRY\\s+OF\\s+ORIGIN\\s+SOUTH\\s+AFRICA)"
    },
    {
      "name": "Supplier address",
      "pattern": "DOLE\\s+SOUTH\\s+AFRICA\\s*\\(PTY\\)\\s*LTD,?\\s*26\\s+BELLA\\s+ROSA.{0,20}?,?\\s*BELLVILLE,?\\s*7530"
    },
    {
      "name": "Importer heading",
      "pattern": "IMPORTED\\s+BY"
    },
    {
      "name": "Importer address",
      "pattern": "EUROPE\\s+GMBH\\s*[/7]?\\s*STADTDEICH"
    },
    {
      "name": "Importer GLN",
      "pattern": "4014071000001"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GrowerGGN"
    },
    {
      "name": "Variety lookup",
      "table": "whatsapp-variety",
      "key": {
        "VarietyName": "field:Variety"
      },
      "query": true,
      "disambiguate_by": {
        "candidate_attribute": "VarietyGroupCode",
        "reference_table": "whatsapp-variety-group",
        "reference_key_attribute": "VarietyGroupCode",
        "reference_compare_attribute": "LidlTranslations",
        "compare_zone": "Variety Group languages"
      },
      "store_as": "variety"
    },
    {
      "name": "Variety Group languages content check",
      "table": "whatsapp-variety-group",
      "key": {
        "VarietyGroupCode": "result:variety.VarietyGroupCode"
      },
      "compare_attribute": "LidlTranslations",
      "compare_zone": "Variety Group languages",
      "fuzzy_threshold": 0.9
    },
    {
      "name": "Lidl Product Number / Commodity cross-check",
      "table": "whatsapp-commodity",
      "key": {
        "Commodity": "result:variety.Commodity"
      },
      "compare_attribute": "LidlProductNumber",
      "compare_zone": "LidlProductNumber"
    },
    {
      "name": "IAN Numbers cross-check",
      "table": "whatsapp-ian-numbers",
      "key": {
        "lookup_key": [
          "result:variety.Commodity",
          "result:variety.VarietyGroupCode",
          "field:Pack",
          "field:InventoryCode"
        ]
      },
      "compare_attribute": "IANNumber",
      "compare_zone": "IANNumber"
    }
  ],
  "size_prompt_checks": [
    {
      "name": "Size Prompt",
      "commodity_source": "result:variety.Commodity"
    }
  ],
  "warning_checks": [
    {
      "name": "Packhouse GGN check",
      "field": "PackhouseGGN",
      "compare_field": "GrowerGGN"
    }
  ]
}
