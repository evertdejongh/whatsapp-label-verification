{
  "layout_agnostic": true,
  "extract_fields": {
    "GTIN": "the actual 13-digit GTIN printed below the barcode graphic (GS1-128 symbology) -- it is preceded in the human-readable text by a GS1 Application Identifier in parentheses, e.g. '(01)'; that parenthetical AI is NOT part of the GTIN and must be excluded, transcribe only the 13 digits that follow it",
    "Pack": null,
    "InventoryCode": null,
    "Brand": "the value printed next to the 'Brand/Mark' heading",
    "BerrySize": "the value printed next to the 'Berry Size' heading (e.g. 'Regular', 'L', 'XL', 'XXL')"
  },
  "field_checks": [
    {
      "field": "GTIN",
      "name": "GTIN",
      "expected_pattern": "^(\\(\\d{2}\\)\\s*)?4311"
    },
    {
      "field": "Pack",
      "name": "Allowed Pack code",
      "expected_pattern": "^A05D$"
    },
    {
      "field": "InventoryCode",
      "name": "Allowed Inventory code",
      "expected_pattern": "^UE$"
    },
    {
      "field": "BerrySize",
      "name": "Allowed Berry Size",
      "expected_pattern": "^(Regular|L|XL)$"
    },
    {
      "field": "Brand",
      "name": "Allowed Brand",
      "expected_pattern": "^BLACK$"
    }
  ],
  "text_blocks": {
    "Variety Group": "the short line of text directly beneath the Variety Name showing the produce name in English and German (e.g. 'White Seedless/Trauben hell kernlos')"
  },
  "text_block_checks": [
    {
      "block": "Variety Group",
      "expected_token_count": 2
    }
  ],
  "full_label_checks": [
    {
      "name": "Commodity heading",
      "pattern": "COMMODITY\\s*/\\s*PRODUKT"
    },
    {
      "name": "Variety heading",
      "pattern": "VARIETY\\s*/\\s*SORTE"
    },
    {
      "name": "Class heading",
      "pattern": "CLASS\\s*/\\s*CAT\\s*/\\s*KLASSE"
    },
    {
      "name": "Origin statement (English)",
      "pattern": "ORIGIN\\s*:?\\s*SOUTH\\s+AFRICA"
    },
    {
      "name": "Origin statement (German)",
      "pattern": "URSPRUNG\\s*:?\\s*S.DAFRIKA"
    },
    {
      "name": "Abgepakt von address",
      "pattern": "ABGEPAC?KT\\s+VON\\s*:?\\s*DOLE\\s+SOUTH\\s+AFRICA\\s*\\(PTY\\)\\s*LTD\\s*[,.]?\\s*26\\s+BELLA\\s+ROSA.{0,20}?\\s*[,.]?\\s*[D0].{0,2}URBAN\\s+SQR\\s*[,.]?\\s*ZA\\s+KAPSTADT\\s*7530\\s*S.DAFRIKA"
    },
    {
      "name": "EDEKA line",
      "pattern": "F.R\\s*:?\\s*EDEKA\\s+AG\\s*[,.]?\\s*WWW\\.EDEKA\\.DE"
    },
    {
      "name": "Exported by address",
      "pattern": "EXPORTED\\s+BY\\s*:?\\s*DOLE\\s+SOUTH\\s+AFRICA\\s*\\(PTY\\)\\s*LTD\\s*[,.]?\\s*26\\s+BELLA\\s+ROSA.{0,20}?\\s*[,.]?\\s*[D0].{0,2}URBAN\\s+SQUARE\\s*[,.]?\\s*CAPE\\s+TOWN\\s*7530"
    }
  ]
}
