{
  "layout_agnostic": true,
  "extract_fields": {
    "PUC": null,
    "GGN": "the 13-digit GGN number printed on the label",
    "LotNumber": "the lot/batch code printed next to the 'Lot no.' heading (e.g. 'L 37 - 01')",
    "GTIN": "the 13-digit GTIN printed below the barcode graphic -- if it is preceded by a GS1 Application Identifier in parentheses, e.g. '(01)', that parenthetical AI is NOT part of the GTIN and must be excluded, transcribe only the 13 digits"
  },
  "field_checks": [
    {
      "field": "GGN",
      "name": "GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    },
    {
      "field": "GTIN",
      "name": "GTIN",
      "expected_pattern": "^(\\(\\d{2}\\)\\s*)?4311"
    },
    {
      "field": "LotNumber",
      "name": "Lot number format",
      "expected_pattern": "^L\\s(0[1-9]|[1-4][0-9]|5[0-3])\\s-\\s(0[1-7])$"
    }
  ],
  "full_label_checks": [
    {
      "name": "Origin statement",
      "pattern": "URSPRUNG\\s*:?\\s*S.DAFRIKA"
    },
    {
      "name": "Abgepackt von heading",
      "pattern": "ABGEPAC?KT\\s+VON\\s*:?\\s*DOLE\\s+SOUTH\\s+AFRICA\\s*\\(PTY\\)\\s*LTD\\s*,?"
    },
    {
      "name": "Street address",
      "pattern": "26\\s+BELLA\\s+ROSA.{0,20}?\\s*[,.]?\\s*[D0].{0,2}URBAN\\s+SQR\\s*[,.]?\\s*ZA\\s+KAPSTADT\\s*7530\\s*S.DAFRIKA"
    },
    {
      "name": "EDEKA line",
      "pattern": "F.R\\s*:?\\s*EDEKA\\s*,?\\s*WWW\\.EDEKA\\.DE"
    },
    {
      "name": "GLN",
      "pattern": "GLN\\s*:?\\s*6009644340002"
    },
    {
      "name": "500g printed",
      "pattern": "500\\s*G"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GGN"
    },
    {
      "name": "EDEKA GTIN cross-check",
      "table": "whatsapp-edeka-gtins",
      "scan_match": {
        "match_fields": [
          {"source": "field:GTIN", "attribute": "GTINpunnet", "fuzzy_min_score": 0.92}
        ]
      }
    }
  ]
}
