{
  "layout_agnostic": true,
  "extract_fields": {
    "OrderNumber": "the value printed next to 'Номер партии:'",
    "PUC": "the value printed next to 'PUC/УКП:'",
    "GGN": "the 13-digit value printed next to 'GGN/ГГН:'"
  },
  "field_checks": [
    {
      "field": "OrderNumber",
      "name": "Order number format",
      "expected_pattern": "^.{4,}$"
    },
    {
      "field": "GGN",
      "name": "GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GGN"
    }
  ]
}
