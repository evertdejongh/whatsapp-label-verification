{
  "layout_agnostic": true,
  "extract_fields": {
    "PUC": null,
    "Variety1": "the first variety name printed next to the 'Variety/Sorte' heading (a mix label lists two names separated by '/')",
    "Variety2": "the second variety name printed next to the 'Variety/Sorte' heading, after the '/' separator",
    "GGN": "the 13-digit GGN number printed on the label",
    "LotNumber": "the lot/batch code printed on the label"
  },
  "field_checks": [
    {
      "field": "Variety1",
      "name": "First variety present"
    },
    {
      "field": "Variety2",
      "name": "Second variety present"
    },
    {
      "field": "GGN",
      "name": "GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    },
    {
      "field": "LotNumber",
      "name": "Lot number"
    }
  ],
  "full_label_checks": [
    {
      "name": "Origin statement",
      "pattern": "URSPRUNG\\s*:?\\s*S.DAFRIKA"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GGN"
    },
    {
      "name": "Variety 1 lookup",
      "table": "whatsapp-variety",
      "key": {
        "VarietyName": "field:Variety1"
      },
      "query": true,
      "store_as": "variety1"
    },
    {
      "name": "Variety 2 lookup",
      "table": "whatsapp-variety",
      "key": {
        "VarietyName": "field:Variety2"
      },
      "query": true,
      "store_as": "variety2"
    }
  ]
}
