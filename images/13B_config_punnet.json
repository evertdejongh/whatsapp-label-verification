{
  "layout_agnostic": true,
  "extract_fields": {
    "PUC": null,
    "Variety": null,
    "GGN": "the 13-digit GGN number printed on the label",
    "LotNumber": "the lot/batch code printed next to the 'Los' heading (e.g. 'L4603' or 'L 46 - 03')",
    "LabelColor": "the dominant background color of the label itself, not the printed text color -- e.g. 'Green', 'Red'"
  },
  "field_checks": [
    {
      "field": "GGN",
      "name": "GGN",
      "expected_pattern": "\\b\\d{13}\\b"
    },
    {
      "field": "LotNumber",
      "name": "Lot number"
    }
  ],
  "full_label_checks": [
    {
      "name": "Origin statement",
      "pattern": "URSPRUNG\\s*:?\\s*S.DAFRIKA"
    },
    {
      "name": "E4711 marking",
      "pattern": "E4711"
    }
  ],
  "lookup_rules": [
    {
      "name": "PUC / GGN cross-check",
      "table": "whatsapp-puc",
      "key": {
        "PUC": "field:PUC"
      },
      "compare_attribute": "GGN",
      "compare_zone": "GGN"
    },
    {
      "name": "Variety lookup",
      "table": "whatsapp-variety",
      "key": {
        "VarietyName": "field:Variety"
      },
      "query": true,
      "store_as": "variety"
    }
  ],
  "color_tag_checks": [
    {
      "name": "Label color matches variety group",
      "variety_group_source": "result:variety.VarietyGroupCode",
      "field": "LabelColor",
      "tag_by_variety_group": {
        "WS": "GREEN",
        "RS": "RED"
      }
    }
  ]
}
